ui_text("Write once. Compile to WebAssembly or native code.", 128, 238, 18, 11776947, "sans-serif")

ui_text("What is Source?", 112, 384, 30, 16777215, "sans-serif")
ui_text("Source is a modern, approachable language with a compact C11 compiler.", 112, 444, 18, 14737632, "sans-serif")
ui_text("Its Canvas runtime and WebAssembly output ship without frameworks.", 112, 482, 18, 14737632, "sans-serif")
ui_text("How it works", 764, 384, 30, 16777215, "sans-serif")
ui_text("One source file, two direct compilation paths:", 764, 444, 18, 14737632, "sans-serif")
ui_text("Source  ->  C  ->  WebAssembly", 764, 488, 20, 16777215, "monospace")
ui_text("Source  ->  QBE IL  ->  native", 764, 530, 20, 16777215, "monospace")

ui_text("A taste of the syntax", 112, 666, 30, 16777215, "sans-serif")
ui_code("var x: int = 10\nwhile true do\n    draw_rect_filled(x, 20, 80, 24, 16777215)\n    flip()\nend", 112, 724, 760, 196)

while true do
    if ui_button("Copy code", 904, 724, 360, 64, "copy-code") then
        copy_to_clipboard("var x: int = 10\nwhile true do\n    draw_rect_filled(x, 20, 80, 24, 16777215)\n    flip()\nend")
    end
    if ui_button("Download Sourc v0.1.0", 904, 812, 360, 72, "download-source") then
        print("Opening the Sourc release page")
    end
    flip()
end

ui_text("Fast builds. Small output. No framework required.", 112, 1026, 22, 16777215, "sans-serif")
